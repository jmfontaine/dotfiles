function update {
  echo -e "\033[1m────────── \033[32mHomebrew\033[0m\033[1m ──────────\033[0m"
  HOMEBREW_NO_UPGRADE_QUIT_CASKS=1 brew bundle install --global --quiet --upgrade
  HOMEBREW_NO_UPGRADE_QUIT_CASKS=1 brew upgrade --yes
  brew bundle cleanup --force --global
  brew autoremove --quiet
  echo ""

  echo "\033[1m────────── \033[32mAntidote\033[0m\033[1m ──────────\033[0m"
  source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh
  antidote update --bundles
  echo ""

  echo "\033[1m────────── \033[32muv\033[0m\033[1m ──────────\033[0m"
  uv tool upgrade --all
  uv cache prune
  echo ""

  echo "\033[1m────────── \033[32mAgent Skills\033[0m\033[1m ──────────\033[0m"
  npx -y skills update -g
  echo ""
}

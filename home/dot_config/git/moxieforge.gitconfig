# Included for repositories under ~/Projects/MoxieForge/ (see ~/.gitconfig).

[user]
  email      = jm@moxieforge.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOWpCtzapnHJz6mFkECuxx8YBwHftlPwts+OZIDI7M2S

# Key that unattended coding agents sign with (parallel-issues skill). Only the
# 1Password reference and its account are stored here; the key is read at launch.
# The account is the MoxieForge account's ID: `op --account` doesn't take its name.
[agent]
  signingAccount = TSFFD6NV2BCAZMR3GGOJGDCU2I
  signingKey     = op://Personal/MoxieForge Coding Agent SSH Key/private key?ssh-format=openssh

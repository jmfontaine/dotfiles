### zsh path (must be first)
typeset -U path fpath # Drop duplicate entries
path=(
    /opt/homebrew/opt/coreutils/libexec/gnubin # Use GNU commands instead of macOS ones
    /opt/homebrew/opt/curl/bin                 # Use Homebrew's curl over MacOS's
    /opt/homebrew/opt/postgresql@18/bin        # PostgreSQL CLI tools
    $HOME/.local/bin
    $path
)

# Load the direnv environment before instant prompt: its output would trigger the
# Powerlevel10k console output warning afterwards.
(( ${+commands[direnv]} )) && emulate zsh -c "$(direnv export zsh)"

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Use VS Code as editor
export EDITOR='code --new-window --wait'

# Disable Homebrew hints
export HOMEBREW_NO_ENV_HINTS=1

# Configure bat
export BAT_PAGING='never'

# Use bat to colorize man
export MANPAGER="sh -c 'col -bx | bat -p -lman'"
export MANROFFOPT='-c'

# Hook direnv for directory changes. Runs after instant prompt; see above.
(( ${+commands[direnv]} )) && emulate zsh -c "$(direnv hook zsh)"

# Load zsh plugins
source ~/.zsh_plugins.zsh

# Configure zsh-autosuggestions
ZSH_AUTOSUGGEST_HISTORY_IGNORE="(cd *|exit|eza *|ls *|pwd|.|..*|* --help|* --version)"
ZSH_AUTOSUGGEST_STRATEGY=(abbreviations history)

# Configure Powerlevel10k prompt
source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh # To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.

# Configure zsh history
# These are additional settings beyond what mattmc3/zephyr history plugin sets
setopt share_history # Share history between all sessions

# Configure zsh-patina
eval "$(zsh-patina activate)"

[alias]
  ci = commit
  co = checkout
  st = status
  wt = worktree
  wtl = worktree list
  wtp = worktree prune

  # Display a nicely formatted history
  lg = log --pretty=tformat:'%Cred%h%Creset %cr - %C(bold)%s%Creset %C(yellow)%G?%Creset %Cgreen(%aN)%Creset' --date=relative

  # Delete the latest commit but preserve its changes
  oops = reset 'HEAD^' --soft

  # Commit all current changes with "WIP" as commit message
  wip = !git add -A && git commit -m 'WIP'

  # Create a new worktree and branch with the same name
  wta = "!f() { git worktree add $1 -b $1; }; f"

[agent]
  # parallel-issues: omp overlay for unattended workers, the command that
  # `status --wait` runs to notify me (title as argument, report on stdin), and the
  # program agents sign with, which refuses during quiet hours (see quiet-hours).
  notifyCommand = ~/.local/bin/notify-pushover
  ompConfig     = ~/.omp/agent/worker.yml
  sshProgram    = quiet-hours-ssh-keygen

[commit]
  gpgsign = true

[core]
  pager = "diff-so-fancy"

# GitHub fetches and pushes go over HTTPS with gh's token (see [url] below), so they
# work while the 1Password SSH agent is locked. The empty value drops inherited helpers
# (Homebrew's osxkeychain) for github.com. `gh` is ~/.local/bin/gh, which refuses
# pushes during quiet hours. Commit signing still goes through 1Password.
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential

[filter "lfs"]
  clean    = git-lfs clean -- %f
  process  = git-lfs filter-process
  required = true
  smudge   = git-lfs smudge -- %f

[gpg]
  format = ssh

# The program is found on PATH: it wraps 1Password's op-ssh-sign and refuses to sign
# during quiet hours (see quiet-hours).
[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers
  program            = quiet-hours-op-ssh-sign

[init]
  defaultBranch = main

[interactive]
  diffFilter = "diff-so-fancy --patch"

[push]
  autoSetupRemote = true

[tag]
  gpgsign = true

[url "https://github.com/"]
  insteadOf = git@github.com:
  insteadOf = ssh://git@github.com/

# No default email or key: each location below sets its own, and useConfigOnly makes
# a commit anywhere else fail instead of guessing an identity.
[user]
  name          = Jean-Marc Fontaine
  useConfigOnly = true

[includeIf "gitdir:~/Projects/Personal/"]
  path = ~/.config/git/personal.gitconfig

[includeIf "gitdir:~/Projects/Third Parties/"]
  path = ~/.config/git/personal.gitconfig

[includeIf "gitdir:~/.local/share/chezmoi/"]
  path = ~/.config/git/personal.gitconfig

[includeIf "gitdir:~/Projects/MoxieForge/"]
  path = ~/.config/git/moxieforge.gitconfig

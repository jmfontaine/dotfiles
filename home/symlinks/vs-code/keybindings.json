[
  {
    "key": "cmd+k cmd+k",
    "command": "toggle",
    "when": "editorTextFocus",
    "args": {
      "id": "fontSize",
      "value": [
        {
          "editor.fontSize": 14,
          "terminal.integrated.fontSize": 14
        },
        {
          "editor.fontSize": 15,
          "terminal.integrated.fontSize": 15
        }
      ]
    }
},
{
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
        "text": "\u001b\r"
    },
    "when": "terminalFocus"
}
]
